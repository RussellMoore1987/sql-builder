{
    "name": "acme/app",
    "description": "PHP Sql Builder",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
        "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
        "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "php -d pcov.enabled=1 -d pcov.directory=/app ./vendor/bin/phpunit --coverage-text"
    }
}
